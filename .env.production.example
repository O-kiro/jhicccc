# Salin jadi `.env` di folder ini, lalu isi. Jangan pernah commit `.env`.
#
# PENTING: ketiganya dibaca saat `npm run build`, bukan hanya saat jalan.
# SITE_URL ikut tercetak ke sitemap.xml, robots.txt, tag kanonik, dan gambar
# OpenGraph — kalau salah saat build, membetulkannya butuh build ulang.

# Alamat situs ini, tanpa garis miring di ujung.
SITE_URL=https://jhic2026.rezasidin.my.id

# Alamat API Laravel. Di satu VPS yang sama, backend biasanya di port 8000.
# Frontend memanggilnya dari sisi server, jadi localhost sudah cukup dan
# tidak perlu dibuka ke publik.
API_URL=http://127.0.0.1:8000/api/v1

# Harus sama persis dengan SITUS_REVALIDATE_SECRET di backend. Dipakai panel
# admin untuk menyuruh situs memuat ulang isinya begitu konten disimpan.
# Kosongkan kalau belum perlu — situs tetap menyusul sendiri maksimal 60 detik.
# Buat nilainya dengan: openssl rand -hex 32
REVALIDATE_SECRET=

# Port yang didengarkan server. Isi kalau panel hosting menentukan port
# sendiri; `.next/standalone/server.js` membacanya dari sini.
# PORT=3000
# HOSTNAME=127.0.0.1
