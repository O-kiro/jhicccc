# Salin jadi .env di server: cp .env.production.example .env
# Dibaca compose.prod.yaml. Jangan commit .env yang sudah terisi.

# Alamat publik situs (tanpa garis miring di akhir).
SITE_URL=https://jhic2026.rezasidin.my.id

# Alamat backend dari dalam container. Kalau backend berjalan di host yang
# sama, biarkan seperti ini; kalau terpisah, isi alamat publiknya.
API_URL=http://host.docker.internal:8000/api/v1

# Harus SAMA dengan SITUS_REVALIDATE_SECRET di .env backend.
#     openssl rand -hex 32
REVALIDATE_SECRET=
