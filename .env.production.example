# Salin jadi `.env` di folder ini: cp .env.production.example .env
# Jangan pernah commit `.env` yang sudah terisi.
#
# Dibaca oleh compose.prod.yaml (cara Docker) maupun `npm run build` langsung
# (cara panel hosting). PENTING: SITE_URL dan API_URL dibaca **saat build**,
# bukan cuma saat jalan. SITE_URL tercetak permanen ke sitemap.xml, robots.txt,
# tag kanonik, dan gambar OpenGraph — salah isi berarti build ulang.

# Alamat publik situs, tanpa garis miring di ujung.
SITE_URL=https://jhic26.rezasidin.my.id

# Alamat API Laravel. Pilih sesuai cara pasang:
#   Docker (dua repo)  → http://backend:8000/api/v1
#   VPS/panel, tanpa Docker → http://127.0.0.1:8000/api/v1
#   backend beda mesin → alamat publiknya
#
# JANGAN memakai alamat publik kalau backend ada di VPS yang sama dan di
# belakang NAT: container tidak bisa keluar lalu berbalik masuk ke IP-nya
# sendiri, dan gagalnya terbaca sebagai "fetch failed" yang membingungkan.
# `backend` itu alias di jaringan Docker bersama (lihat compose.prod.yaml).
API_URL=http://backend:8000/api/v1

# Harus SAMA PERSIS dengan SITUS_REVALIDATE_SECRET di .env backend. Dipakai
# panel admin untuk menyuruh situs memuat ulang isinya begitu konten disimpan.
# Kosongkan kalau belum perlu — situs tetap menyusul sendiri maksimal 60 detik.
#     openssl rand -hex 32
REVALIDATE_SECRET=

# Hanya untuk cara panel hosting: port dan alamat yang didengarkan
# `.next/standalone/server.js`. Isi kalau panel menentukan port sendiri.
# PORT=3000
# HOSTNAME=127.0.0.1

# Jumlah thread saat membangun frontend. Bawaannya 2. Turunkan ke 1 di server
# yang plafon prosesnya ketat (mis. OpenVZ) — gejalanya build berhenti dengan
# "Resource temporarily unavailable" walau memori terlihat lega.
# NEXT_BUILD_CPUS=1

# Chatbot "Asisten MAKOBA" di situs publik (Gemini, https://aistudio.google.com/apikey).
# Kosong = asisten menjawab "sedang tidak tersedia".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
